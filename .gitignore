# Dati di addestramento e artefatti grezzi: mai in git, per costruzione.
# Le eccezioni esplicite sotto sono l'unico modo in cui questi pattern
# possono entrare nel repo.
*.tsv
*.tsv.gz
*.bin
*.epd
*.pgn
*.pgn.gz
*.npy
*.pt
*.csv.gz
data/
datasets/
shards/

# Segreti e configurazione locale
*.pem
*_rsa
*_ed25519
luna_oracle
luna_oracle.pub
.env
*.key

# Eccezioni esplicite: questo E' il materiale che deve entrare nel repo
!nets/*.nnue
!nets/*.sha256
!results/**
!**/manifest*.json
!checksums/**/*.csv
!checksums/**/*.txt
