# Training data and raw artifacts: never in git, by construction.
# The explicit exceptions below are the only way these patterns
# can enter the repo.
*.tsv
*.tsv.gz
*.bin
*.epd
*.pgn
*.pgn.gz
*.npy
*.pt
*.csv.gz
data/
datasets/
shards/

# Python bytecode cache (created locally by running/compiling any script)
__pycache__/
*.pyc

# Secrets and local configuration
*.pem
*_rsa
*_ed25519
luna_oracle
luna_oracle.pub
.env
*.key

# Explicit exceptions: this IS the material that must enter the repo
!nets/*.nnue
!nets/*.sha256
!results/**
!**/manifest*.json
!checksums/**/*.csv
!checksums/**/*.txt
